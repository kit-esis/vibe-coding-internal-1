<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#f7f9f7">
  <meta name="description" content="Interaktive Stadtkarte der Hansestadt Osterburg (Altmark).">
  <title><%= title %></title>

  <link rel="preconnect" href="https://unpkg.com">
  <link rel="preconnect" href="https://tile.openstreetmap.org">
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
  >

  <style>
    :root {
      color-scheme: light;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-synthesis: none;
      text-rendering: optimizeLegibility;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      --header-height: 68px;
      --ink: #17251e;
      --muted: #718078;
      --green: #27664b;
      --line: #e6ebe7;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      width: 100%;
      height: 100%;
      margin: 0;
    }

    body {
      display: flex;
      flex-direction: column;
      height: 100vh;
      height: 100dvh;
      min-height: 320px;
      overflow: hidden;
      color: var(--ink);
      background: #f7f9f7;
    }

    .topbar {
      position: relative;
      z-index: 500;
      display: flex;
      flex: 0 0 var(--header-height);
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      min-width: 0;
      padding: 0 clamp(16px, 3vw, 30px);
      border-bottom: 1px solid var(--line);
      background: rgba(255, 255, 255, 0.98);
    }

    .brand {
      display: inline-flex;
      min-width: 0;
      align-items: center;
      gap: 11px;
      color: inherit;
      text-decoration: none;
    }

    .brand-mark {
      display: grid;
      width: 38px;
      height: 38px;
      flex: 0 0 38px;
      place-items: center;
      border-radius: 12px;
      background: var(--green);
      box-shadow: 0 2px 5px rgba(26, 65, 46, 0.14);
    }

    .brand-mark svg {
      display: block;
      width: 22px;
      height: 22px;
    }

    .brand-copy {
      display: flex;
      min-width: 0;
      flex-direction: column;
      gap: 2px;
    }

    .brand-name {
      overflow: hidden;
      font-size: 14px;
      font-weight: 680;
      letter-spacing: -0.02em;
      line-height: 1.25;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .brand-subtitle {
      color: var(--muted);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.025em;
      line-height: 1.2;
    }

    .topbar-label {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      gap: 8px;
      padding: 7px 11px;
      border: 1px solid #e9eeea;
      border-radius: 999px;
      color: #53645a;
      background: #fbfcfb;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.015em;
    }

    .topbar-label::before {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #4d956f;
      content: "";
    }

    .map-shell {
      position: relative;
      flex: 1 1 auto;
      min-height: 0;
      background: #e9efeb;
    }

    #map {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      outline: none;
      background: #e9efeb;
    }

    .map-fallback {
      position: absolute;
      z-index: 700;
      top: 16px;
      left: 50%;
      width: max-content;
      max-width: calc(100% - 32px);
      padding: 11px 15px;
      transform: translateX(-50%);
      border: 1px solid #f0d4ce;
      border-radius: 10px;
      color: #8b3425;
      background: #fff8f6;
      box-shadow: 0 4px 16px rgba(33, 46, 38, 0.08);
      font-size: 13px;
      text-align: center;
    }

    .map-fallback[hidden] {
      display: none;
    }

    .leaflet-container {
      font: inherit;
    }

    .leaflet-bar {
      overflow: hidden;
      border: 1px solid rgba(26, 45, 34, 0.12) !important;
      border-radius: 11px !important;
      box-shadow: 0 3px 12px rgba(28, 46, 35, 0.12) !important;
    }

    .leaflet-bar a,
    .leaflet-bar a:hover {
      width: 40px !important;
      height: 40px !important;
      line-height: 40px !important;
      border-bottom-color: #edf0ed !important;
      color: #294b39 !important;
      background: #fff !important;
    }

    .leaflet-bar a:hover {
      color: #173c29 !important;
      background: #f4f8f5 !important;
    }

    .leaflet-control-attribution {
      padding: 3px 7px !important;
      border-top-left-radius: 6px;
      color: #56645c !important;
      background: rgba(255, 255, 255, 0.88) !important;
      font-size: 10px !important;
    }

    .leaflet-control-attribution a {
      color: #315f47 !important;
    }

    @media (max-width: 520px) {
      :root {
        --header-height: 60px;
      }

      .topbar {
        gap: 8px;
        padding-right: 13px;
        padding-left: 13px;
      }

      .brand {
        gap: 9px;
      }

      .brand-mark {
        width: 35px;
        height: 35px;
        flex-basis: 35px;
        border-radius: 11px;
      }

      .brand-name {
        max-width: min(66vw, 310px);
        font-size: 12.5px;
      }

      .brand-subtitle {
        font-size: 10px;
      }

      .topbar-label {
        gap: 6px;
        padding: 6px 8px;
        font-size: 10px;
      }

      .leaflet-top {
        top: 6px;
      }

      .leaflet-right {
        right: 6px;
      }

      .leaflet-bottom {
        bottom: 4px;
      }

      .leaflet-left {
        left: 6px;
      }
    }

    @media (max-width: 360px) {
      .topbar-label {
        display: none;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>

<body>
  <header class="topbar">
    <a class="brand" href="/" aria-label="Hansestadt Osterburg – Stadtkarte">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M19 10.1C19 15.1 12 21 12 21S5 15.1 5 10.1a7 7 0 1 1 14 0Z" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="12" cy="10" r="2.35" stroke="#fff" stroke-width="1.8"/>
        </svg>
      </span>
      <span class="brand-copy">
        <span class="brand-name"><%= cityName %></span>
        <span class="brand-subtitle">Altmark · Sachsen-Anhalt</span>
      </span>
    </a>

    <span class="topbar-label">Stadtkarte</span>
  </header>

  <main class="map-shell" aria-label="Interaktive Stadtkarte">
    <div id="map" role="application" aria-label="Karte von Hansestadt Osterburg. Mit Maus, Touch oder Tastatur verschieb- und zoombar."></div>
    <div id="map-fallback" class="map-fallback" role="status" hidden>
      Die Karte konnte nicht geladen werden. Bitte prüfe deine Internetverbindung.
    </div>
  </main>

  <script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
    crossorigin=""
  ></script>
  <script>
    (() => {
      const fallback = document.getElementById("map-fallback");

      if (typeof L === "undefined") {
        fallback.hidden = false;
        return;
      }

      const map = L.map("map", {
        center: [<%= latitude %>, <%= longitude %>],
        zoom: <%= zoom %>,
        zoomControl: false,
        scrollWheelZoom: true,
        preferCanvas: true
      });

      L.control.zoom({ position: "topright" }).addTo(map);

      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        minZoom: 5,
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a>-Mitwirkende'
      }).addTo(map);

      // Leaflet is initialized after the layout is available; recalculate on resize.
      window.addEventListener("resize", () => map.invalidateSize());
      window.addEventListener("load", () => map.invalidateSize());
    })();
  </script>
</body>
</html>
